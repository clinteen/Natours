extends sidebar

block sidebar-content
    .card-container_admin
        each tour in documents
            .card_admin 
                .card_header_admin 
                    .img_container
                        img.img_admin(src=`/img/tours/${tour.imageCover}`, alt=`${tour.name}`)
                        span.tour_name #{tour.name}
                    .card_div_admin 
                        .card__data
                            svg.card__icon 
                                use(xlink:href='/img/icons.svg#icon-map-pin')
                            span Price: #{tour.price}
                        .card__data
                            svg.card__icon 
                                use(xlink:href='/img/icons.svg#icon-star')
                            span Duration: #{tour.duration}
                        .card__data
                            svg.card__icon 
                                use(xlink:href='/img/icons.svg#icon-star')
                            span Average Rating: #{tour.ratingsAverage}
                        .card__data
                            svg.card__icon 
                                use(xlink:href='/img/icons.svg#icon-map-pin')
                            span Rating Quantity: #{tour.ratingsQuantity}
                    .card_footer_admin 
                        a.admin_btn(href=`/admin/tour-update/${tour._id}`) Update 
                        a.delete_resource.admin_btn(data-id=`${tour._id}` data-resource='tours') Delete
                        a.admin_btn(href=`/tours/${tour.slug}`) View 
        .pages_sections 
            if(currentPage > 1)
                a#previous(href=`?page=${currentPage - 1}`) Prev
            span Page #{currentPage} of #{totalPages}
            if(currentPage < totalPages) 
                a#next(href=`?page=${currentPage + 1}`) Next
        a#create_documents(href=`/admin/tour-update`) Create New Tour



