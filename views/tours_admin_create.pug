extends base

block content
    main.main 
        .login-form 
            h2.heading-secondary.ma-bt-lg #{tourGuides ? 'Update Tour' : 'Create Tour'} 
            form.form#create_tour_form(enctype='multipart/form-data')
                .form__group 
                    label.form__label(for='tour_name') Tour Name: 
                    input#tour_name.form__input(type='text', required, value=`${tourGuides ? tourGuides.name : ''}`)
                .form__group 
                    label.form__label(for='tour_duration') Tour Duration: 
                    input#tour_duration.form__input(type='number', required, value=`${tourGuides ? tourGuides.duration : ''}`)
                .form__group 
                    label.form__label(for='maxGroupSize') Max Group Size: 
                    input#maxGroupSize.form__input(type='number', required, value=`${tourGuides ? tourGuides.maxGroupSize : ''}`)
                .form__group 
                    label.form__label(for='difficulty') Difficulty: 
                    input#difficulty.form__input(type='text', required, value=`${tourGuides ? tourGuides.difficulty : ''}`)
                .form__group 
                    label.form__label(for='price') Price: 
                    input#price.form__input(type='number', required, value=`${tourGuides ? tourGuides.price : ''}`)
                .form__group 
                    label.form__label(for='price_discount') Price Discount: 
                    input#price_discount.form__input(type='number', value=`${tourGuides ? tourGuides.priceDiscount : ''}`)
                .form__group 
                    label.form__label(for='summary') Summary: 
                    textarea#summary.form__input(type='text', required)= `${tourGuides ? tourGuides.summary : ''}`
                .form__group 
                    label.form__label(for='description') Description: 
                    textarea#description.form__input(type='text')= `${tourGuides ? tourGuides.description : ''}`
                .form__group
                    .dates_div 
                        label.form__label(for='startDates') StartDates: 
                            .container_all
                                if tourGuides
                                    each date in tourGuides.startDates
                                        .container.date_container 
                                            h3.x x
                                            h5 #{date.date.toLocaleDateString('en-us', {weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'})}
                                            h6 #{date.participants}
                                            p #{date.soldOut} 
                            //- input#startDates.form__input(type='date')
                        button.add_btns#add-date Add Dates
                .form__group 
                    .start_location_div
                        label.form__label(for='start_location') Start Location: 
                            .container_all 
                                if tourGuides
                                    .container.start_location_container 
                                        h3.x x
                                        h5 #{tourGuides.startLocation.type}
                                        h6 #{tourGuides.startLocation.coordinates}
                                        h5 #{tourGuides.startLocation.address}
                                        h5 #{tourGuides.startLocation.description} 
                       
                        button.add_btns#add-start-location Add Location
                .form__group 
                    .locations_div
                        label.form__label(for='locations') Locations: 
                            .container_all 
                                if tourGuides
                                        each location in tourGuides.locations
                                            .container.locations_container 
                                                h3.x x
                                                h5 #{location.type}
                                                h6 #{location.coordinates}
                                                h5 #{location.address} 
                                                h5 #{location.description}
                                                h5 #{location.day}
                        
                        button.add_btns#add-location Add Locations
                .form__group 
                    label#guides_field_1.form__label(for='guides') Guides:
                        .container_all
                            if tourGuides
                                each guide, index in tourGuides.guides
                                    if guide.role === 'guide'
                                        .guide_container 
                                            p(data-guide-id=`${guide._id}`)= guide.name
                                            span.x x
                                
                            else
                                select#guides.form__input(name='guides')
                                    option
                                    each guide in users 
                                        if guide.role === 'guide'
                                            option(value=`${guide._id}`)= guide.name
                                            
                    button.add_btns.add_guides Add Guides
                .form__group
                        label#guides_field_2.form__label(for='lead-guides') Lead Guides:
                            .container_all
                                if tourGuides
                                    each guide in tourGuides.guides
                                        if guide.role === 'lead-guide'
                                            .guide_container 
                                                p(data-guide-id=`${guide._id}`)= guide.name
                                                span.x x
                                    
                                else
                                    select#lead-guides.form__input(name='guides')
                                        option
                                            each guide in users 
                                                if guide.role === 'lead-guide'
                                                    option(value=`${guide._id}`)= guide.name

                        button.add_btns.add_guides Add Lead Guides
                .form__group 
                    label.form__label(for='secret_tour') Secret Tour:  
                    input#secret_tour.form__input(type='boolean', name='secret_tour', value=`${tourGuides ? tourGuides.SecretTour : ''}`)
                .form__group 
                    label.form__label(for='image_cover') Image Cover:  
                    input#image_cover.form__input(type='file', name='imageCover', required)
                .form__group 
                    label.form__label(for='images') Images:  
                    input#images.form__input(type='file', name='images', multiple)
                    span Hold C'trl to select multiple files
                .form__group 
                    button#tours_btn.btn.btn--green(data-action=`${tourGuides ? 'update' : 'create'}`, data-tour-id=`${tourGuides ? tourGuides._id : ''}`) #{tourGuides ? 'Update Tour' : 'Create Tour'}

    
    .back_drops

    form.locations
        .form_group 
            label.form__label(for='type') Type 
            input#type.form__input(type='text')
        .form_group#coordinates_group 
            label.form__label(for='coordinates') Coordinates:
            .inputs_coordinates 
                input#coordinates_1.form__input(type='number', placeholder='latitude', step='any')
                input#coordinates_2.form__input(type='number', placeholder='longitude', step='any')
        .form_group 
            label.form__label(for='address') Address: 
            input#address.form__input(type='text')
        .form_group 
            label.form__label(for='description_location') Description: 
            input#description_loc.form__input(type='text')
        .form_group 
            label.form__label(for='day') Day: 
            input#day.form__input(type='text')
        .form_group#location_btn 
            button.btn.btn--green.create_location Add

    form.start_location
        .form_group 
            label.form__label(for='start_loc_type') Type 
            input#start_loc_type.form__input(type='text')
        .form_group#start_loc_coordinates_group 
            label.form__label(for='start_loc_coordinates') Coordinates:
            .inputs_coordinates 
                input#start_loc_coordinates_1.form__input(type='number', placeholder='latitude', step='any')
                input#start_loc_coordinates_2.form__input(type='number', placeholder='longitude', step='any')
        .form_group 
            label.form__label(for='start_loc_address') Address: 
            input#start_loc_address.form__input(type='text')
        .form_group 
            label.form__label(for='start_loc_description_location') Description: 
            input#start_loc_description_loc.form__input(type='text')
        .form_group#start_loc_location_btn 
            button.btn.btn--green.create_location Add

    form.dates
        .form_group 
            label.form__label(for='date') Date: 
            input#date.form__input(type='date')
        .form_group#coordinates_group 
            label.form__label(for='participants') Participants:
            input#participants.form__input(type='number')
        .form_group 
            label.form__label(for='sold_out') Sold Out: 
            input#sold_out.form__input(type='text')
        .form_group#location_btn 
            button.btn.btn--green.create_location Add