extends base

block content
    main.main 
        .login-form 
            h2.heading-secondary.ma-bt-lg Update User
            form.form#update-user-form
                .form__group 
                    label.form__label(for='tour_name') Name: 
                    input#name.form__input(type='text', required)
                .form__group 
                    label.form__label(for='tour_duration') Email: 
                    input#email.form__input(type='number', required)
                .form__group 
                    label.form__label(for='maxGroupSize') Role: 
                    input#role.form__input(type='number', required)
                .form__group 
                    label.form__label(for='maxGroupSize') Photo: 
                    input#photo.form__input(type='file')
                .form__group 
                    label.form__label(for='maxGroupSize') Active: 
                    input#active.form__input(type='text')
                .form__group 
                    button.btn.btn--green Create User 