extends base

block append head 
    link(rel='stylesheet' href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css')
    script(src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js')

    //- This is the updated version of the stripe documentation. The old version is commented out below.
    //- script( src='https://js.stripe.com/dahlia/stripe.js')
    //- script(src='https://js.stripe.com/v3/')
mixin overviewBox(label, text, urlShort)
    .overview-box__detail 
        svg.overview-box__icon 
            use(xlink:href=`/img/icons.svg#icon-${urlShort}`)
        span.overview-box__label= label 
        span.overview-box__text= text

mixin reviewCard(review)
    .reviews__card 
        .reviews__avatar 
            img.reviews__avatar-img(src=`/img/users/photo.png`, alt=`${review.user.name}`)
            h6.reviews__user= review.user.name 
        p.reviews__text= review.review 
        .reviews__rating 
            each i in [1,2,3,4,5] 
                svg.reviews__star(class=`reviews__star--${i<= review.rating ? 'active' : 'inactive'}`) 
                    use(xlink:href='/img/icons.svg#icon-star')
            //- svg.reviews__star.reviews__star--active 
            //-     use(xlink:href='/img/icons.svg#icon-star')
            //- svg.reviews__star.reviews__star--active 
            //-     use(xlink:href='/img/icons.svg#icon-star')
            //- svg.reviews__star.reviews__star--active 
            //-     use(xlink:href='/img/icons.svg#icon-star')
            //- svg.reviews__star.reviews__star--active 
            //-     use(xlink:href='/img/icons.svg#icon-star')

mixin hasUserBookedTour(secondary_text, duration, cta_text, select_Tag)
    .cta__img.cta__img--logo 
        img(src='/img/logo/white.png', alt='Natours Logo')
        img.cta__img.cta__img--1(src='/img/tour-5-2.jpg', alt='')
        img.cta__img.cta__img--2(src='/img/tour-5-2.jpg', alt='')
    .cta__content 
        h2.heading-secondary #{secondary_text}
        p.cta__text #{duration} #{cta_text} 

        if user
            if reviewed 
                a(href='/') 
                    button.btn.btn--green Try out other tours
            else if bookedTour 
                button#review_btn.btn.btn--green.span-all-rows(data-tour-id=`${tour.id}`) Drop a Review 
            else 
                .date_div
                    h1 Please Select a Date
                    select#select_btn.form_input_date(name='StartDateId', required)
                        option
                        each date in tour.startDates
                            option(value=`${date._id}`)= date.date.toLocaleString('en-us', {month: 'long', year: 'numeric'})
                button#book_btn.btn.btn--green.span-all-rows(data-tour-id=`${tour.id}`) Book Tour Now!
        else 
            a.btn.btn--green.span-all-rows(href='/login') Log In to Book your Tour!


block content 

    include mixin

    .drop_down

    section.review_Form 
        .star_container
            +star_Review(1)
            +star_Review(2)
            +star_Review(3)
            +star_Review(4)
            +star_Review(5)
        .review_container 
            label(for='review') Review 
            textarea(id='review') 
        button.submit_review Post Review

    section.section-header
        .header__hero
            .header__hero-overlay &nbsp;
            img.header__hero-img(src=`/img/tours/${tour.imageCover}`, alt='Tour 5')

        .heading-box 
            h1.heading-primary  
                span #{tour.name} Tour  
            .heading-box__group     
                .heading-box__detail    
                    svg.heading-box__icon 
                        use(xlink:href='/img/icons.svg#icon-clock')
                    span.heading-box__text #{tour.duration} days 
                .heading-box__detail 
                    svg.heading-box__icon 
                        use(xlink:href='/img/icons.svg#icon-map-pin')
                    span.heading-box__text #{tour.startLocation.description}

    section.section-description 
        .overview-box 
            div 
                .overview-box__group 
                    h2.heading-secondary.ma-bt-lg Quick facts
                    -const date = tour.startDates[0].date.toLocaleString('en-us', {month: 'long', year: 'numeric'})
                    +overviewBox('Next Date', date, 'calendar')
                    +overviewBox('Difficulty', tour.difficulty, 'trending-up')
                    +overviewBox('Participants', tour.maxGroupSize, 'users')
                    +overviewBox('Rating', `${tour.ratingsAverage} / 5`, 'star')

                .overview-box__group 
                    h2.heading-secondary.na-bt-lg Your tour guides 
                    each guide in tour.guides 
                        .overview-box__detail 
                            img.overview-box__img(src='/img/users/user/user-19.jpg', alt='Lead Guide')
                            -if(guide.role === 'lead-guide')
                                span.overview-box__label Lead Guide 
                            -if(guide.role === 'guide')
                                span.overview-box__label Tour Guide    
                            span.overview-box__text= guide.name 

        .description-box
            h2.heading-secondary.na-bt-lg About the #{tour.name} tour 
            -const paragraphs = tour.description.split('\n')
            each p in paragraphs 
                p.description__text= p 
            //- p.description__text Summary 

    section.section-pictures 
        each image, index in tour.images
            .picture-box 
                img.picture-box__img(src=`/img/tours/${image}`, alt=`The ${tour.name} Tour ${index + 1}`, class=`picture-box__img--${index + 1}`)

    section.section-map 
        #map(data-locations=JSON.stringify(tour.locations))

    section.section-reviews 
        .reviews 
            each review in tour.reviews 
                +reviewCard(review)

    section.section-cta 
        .cta
            if reviewed
                +hasUserBookedTour('Thank you for your your service!!!')
            else if bookedTour
                +hasUserBookedTour("Did You enjoy the Tour?", `${tour.duration}`, "Please drop a review for others to try it out")
            else 
                +hasUserBookedTour('What are you waiting for?',`${tour.duration}`, `days. 1 adventure. Infinite memories. Make it yours today!`)


    