extends sidebar  

block sidebar-content  
    section.section-reviews.card-container_admin  
        each review in reviews
            .card_admin  
                .review_tour 
                   img.img_admin(src=`/img/tours/${review.tour.imageCover}`, alt=`${review.tour.name}`)
                   span.review_tour_name #{review.tour.name}
                .reviews__avatar 
                    img.reviews__avatar-img(src=`/img/users/photo.png`, alt=`${review.user.name}`)
                    h6.reviews__user= review.user.name 
                p.reviews__text= review.review 
                .reviews__rating 
                    each i in [1,2,3,4,5] 
                        svg.reviews__star(class=`reviews__star--${i<= review.rating ? 'active' : 'inactive'}`)
                            use(xlink:href='/img/icons.svg#icon-star')
                .card_footer_admin 
                    a.user_update_review_btn.admin_btn(data-review-id=`${review._id}`) Edit 
                    a.user_del_review_btn.admin_btn(href=``) Delete 

    include mixin

    .drop_down_edit_review

    section.edit_review_Form 
        .star_container
            +star_Review(1)
            +star_Review(2)
            +star_Review(3)
            +star_Review(4)
            +star_Review(5)
        .review_container 
            label(for='review') Review 
            textarea(id='review') 
        button#edit_review Edit Review
